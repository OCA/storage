<odoo>
    <record id="fs_storage_rule_tree_view" model="ir.ui.view">
        <field name="name">fs.storage.rule.list (in fs_storage)</field>
        <field name="model">fs.storage.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="model_id" />
                <field name="field_id" />
                <field name="storage_id" />
                <field name="domain" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="fs_storage_rule_form_view" model="ir.ui.view">
        <field name="name">fs.storage.rule.form (in fs_storage)</field>
        <field name="model">fs.storage.rule</field>
        <field name="arch" type="xml">
            <form string="FS Storage Rule">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="storage_id" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" />
                            <field
                                name="field_id"
                                context="{'default_model_id': model_id}"
                            />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field
                                name="domain"
                                widget="ace"
                                options="{'mode': 'python'}"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fs_storage_rule_search_view" model="ir.ui.view">
        <field name="name">fs.storage.rule.search (in fs_storage)</field>
        <field name="model">fs.storage.rule</field>
        <field name="arch" type="xml">
            <search string="FS Storage Rule">
                <field name="model_id" />
                <field name="storage_id" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_model"
                        string="Model"
                        context="{'group_by': 'model_id'}"
                    />
                    <filter
                        name="group_by_storage"
                        string="Storage"
                        context="{'group_by': 'storage_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="act_open_fs_storage_rule_view" model="ir.actions.act_window">
        <field name="name">FS Storage Rules</field>
        <field name="res_model">fs.storage.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fs_storage_rule_search_view" />
    </record>

    <menuitem
        id="menu_fs_storage_rule"
        parent="menu_storage"
        sequence="20"
        action="act_open_fs_storage_rule_view"
    />
</odoo>
