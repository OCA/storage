<odoo>
    <record id="product_kanban_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <field name="image_128" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="image_128" position="after">
                <field
                    name="image_medium"
                    widget="fs_image"
                    options="{'img_class': 'o_image_64_contain mw-100'}"
                    alt="Product"
                />
            </field>
        </field>
    </record>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="image_1920" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="image_1920" position="after">
                <field
                    name="image"
                    widget="fs_image"
                    class="oe_avatar"
                    options="{'preview_image': 'image_medium', 'zoom': true}"
                />
            </field>
            <page name="sales" position="after">
                <page name="images" string="Images">
                    <p class="oe_grey">
                        If you need to edit the images, do it from the product template.
                    </p>
                    <field name="variant_image_ids" />
                </page>
            </page>
        </field>
    </record>
    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <field name="image_1920" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="image_1920" position="after">
                <field
                    name="image"
                    widget="fs_image"
                    class="oe_avatar"
                    options="{'preview_image': 'image_medium', 'zoom': true}"
                />
            </field>
        </field>
    </record>
</odoo>
