<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="fs_field.FsFieldFile" t-inherit-mode="primary">
        <tr class="o_data_row">
            <td class="o_data_cell o_fs_field_field_file_icon">
                <i t-attf-class="fa {{icon}}" />
            </td>
            <td class="o_data_cell o_fs_field_field_file_display">
                <t t-esc="props.record.name" />
            </td>
            <td class="o_data_cell o_fs_field_field_file_button">
                <i
                    class="fa fa-download btn btn-link o_fs_field_field_file_button_download"
                    title="Download"
                    t-on-click="props.onClickDownload"
                />
                <i
                    class="fa fa-eye btn btn-link o_fs_field_field_file_button_preview"
                    title="Preview"
                    t-on-click="props.onClickPreview"
                />
                <i
                    class="fa fa-files-o btn btn-link o_fs_field_field_file_button_copy"
                    title="Copy"
                    t-on-click="props.onCopy"
                />
                <i
                    class="fa fa-scissors btn btn-link o_fs_field_field_file_button_cut"
                    title="Cut"
                    t-on-click="props.onCut"
                />
                <i
                    class="fa fa-trash btn btn-link o_fs_field_field_file_button_delete"
                    title="Delete"
                    t-on-click="props.onClickDelete"
                />
            </td>
        </tr>
    </t>

</templates>
