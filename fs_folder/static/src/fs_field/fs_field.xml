<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="fs_field.FsField" t-inherit-mode="primary">
        <button
            class="btn btn-primary oe_highlight"
            t-on-click="onClickInitialize"
            t-if="!props.record.data[props.name]"
        >
            <i class="fa fa-plus" /> Create Folder
        </button>
        <div class="o_list_renderer" t-if="props.record.data[props.name]">
            <div class="o_fs_field_field_header row">
                <div class="col-9" />
                <div class="col-3">
                    <i
                        class="btn btn-link fa fa-plus"
                        t-on-click="onClickAddChildFolder"
                    />
                    <i
                        class="btn btn-link fa fa-clipboard"
                        t-on-click="onPaste"
                        t-if="state.copy"
                    />
                </div>
            </div>
            <div t-if="state.path.length">
                <span class="btn btn-link" t-on-click="returnParent">Home</span> /
                <span
                t-foreach="state.path"
                t-as="path"
                t-key="path_index"
                t-on-click="() => this.returnParent(path)"
            >
                    <t t-esc="path" />
                    /
                </span>
            </div>
            <table
                class="o_list_table table table-sm table-hover mb-0"
                t-ref="dropzone"
            >
                <thead>
                    <tr>
                        <th class="o_list_icon" />
                        <th class="o_list_name">
                            <span>Name</span>
                        </th>
                        <th class="o_list_actions">
                            <span>Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.data" t-as="record" t-key="record.name">
                        <t
                            t-component="getComponent(record)"
                            t-props="getProps(record)"
                        />
                    </t>
                </tbody>
            </table>
        </div>
    </t>

</templates>
