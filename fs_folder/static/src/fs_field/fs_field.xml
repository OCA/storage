<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="fs_field.FsField" t-inherit-mode="primary">
        <button
            class="btn btn-primary oe_highlight"
            t-on-click="onClickInitialize"
            t-if="!props.record.data[props.name]"
        >
            <i class="fa fa-plus" /> Create Folder
        </button>
        <div class="o_list_renderer" t-if="props.record.data[props.name]">
            <div class="o_fs_field_field_header">
                <button
                    class="m-1 btn btn-info o_fs_field_field_file_button_refresh"
                    t-on-click="setData"
                >
                    <i class="fa fa-refresh" />
                </button>
                <button
                    class="m-1 btn btn-info o_fs_field_field_file_button_add_folder"
                    t-on-click="onClickAddChildFolder"
                >
                    <i class="fa fa-folder" />
                </button>

                <FileUploader
                    onUploaded.bind="onAddFile"
                    multiUpload="true"
                    onUploadComplete.bind="setData"
                >
                    <t t-set-slot="toggler">
                        <button
                            class="m-1 btn btn-info o_fs_field_field_file_button_add_file"
                        >
                            <i class="fa fa-file" />
                        </button>
                    </t>
                </FileUploader>
                <button
                    class="m-1 btn btn-link o_fs_field_field_file_button_paste"
                    t-on-click="onPaste"
                    t-if="state.copy"
                >
                    <i class="fa fa-clipboard" />
                </button>
            </div>
            <div>
                <span
                class="btn btn-link"
                t-on-click="() => this.returnParent(-1)"
            >Root</span> /
                <t t-foreach="state.path" t-as="path" t-key="path_index">
                    <span
                t-esc="path"
                class="btn btn-link"
                t-on-click="() => this.returnParent(path_index)"
            />
                    /
                </t>
            </div>
            <table
                class="o_list_table table table-sm table-hover mb-0"
                t-ref="dropzone"
            >
                <thead>
                    <tr>
                        <th t-foreach="fieldDef" t-as="field" t-key="field.name">
                            <span t-esc="field.string" />
                        </th>
                        <th class="o_list_actions">
                            <span>Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.data" t-as="record" t-key="record.name">
                        <FsFieldItem
                            record="record"
                            fieldDef="fieldDef"
                            moreActionDef="moreActionDef"
                        />
                    </t>
                </tbody>
            </table>
        </div>
    </t>

</templates>
