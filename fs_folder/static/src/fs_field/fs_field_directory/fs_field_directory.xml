<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="fs_field.FsFieldDirectory" t-inherit-mode="primary">
        <tr class="o_data_row">
            <td class="o_data_cell">
                <i class="fa fa-folder-o" />
            </td>
            <td class="o_data_cell">
                <t t-esc="props.record.name" t-on-dblclick="props.onClick" />
            </td>
            <td class="o_data_cell">
                <i
                    class="fa fa-sign-in btn btn-link o_fs_field_field_file_button_open"
                    title="Open"
                    t-on-click="props.onClick"
                />
                <i
                    class="fa fa-files-o btn btn-link o_fs_field_field_file_button_copy"
                    title="Copy"
                    t-on-click="props.onCopy"
                />
                <i
                    class="fa fa-scissors btn btn-link o_fs_field_field_file_button_cut"
                    title="Cut"
                    t-on-click="props.onCut"
                />
                <i
                    class="fa fa-trash btn btn-link o_fs_field_field_file_button_delete"
                    title="Delete"
                    t-on-click="props.onClickDelete"
                />
            </td>
        </tr>
    </t>

</templates>
