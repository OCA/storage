<odoo>
    <record id="storage_file_replace_view_form" model="ir.ui.view">
        <field name="model">storage.file.replace</field>
        <field name="inherit_id" ref="storage_file.storage_file_replace_view_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="file_id" position="after">
                <field name="image_id" invisible="1" />
            </field>
            <group name="file" position="attributes">
                <attribute name="string">Image</attribute>
            </group>
            <field name="data" position="attributes">
                <attribute name="widget">image</attribute>
                <attribute name="nolabel">1</attribute>
                <attribute name="options">{'size': (128, 128)}</attribute>
            </field>
        </field>
    </record>

    <record id="storage_replace_file_action" model="ir.actions.act_window">
        <field name="name">Replace File</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">storage.file.replace</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="storage_file_replace_view_form" />
        <field
            name="context"
        >{"withControlPanel": False, "no_breadcrumbs": True}</field>
    </record>
</odoo>
